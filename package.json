{
  "name": "footage",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "server": "npm run dev --workspace=@footage/server",
    "test": "npm test --workspace=@footage/server && npm run test:mobile && npm run test:device-tools",
    "test:mobile": "tsx --test scripts/test/mobile-presentation.test.ts",
    "test:device-tools": "node --test scripts/test/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start --workspace=footage-mobile --",
    "lint": "npm run lint --workspace=footage-mobile",
    "android:build": "bash scripts/build-android.sh",
    "android:demo": "bash scripts/build-android.sh --standalone",
    "ios:build": "bash scripts/build-ios.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
